<div class="flex flex-col gap-4 max-w-2xl w-full">
  <%= link_to "← Back to Companies", companies_path, class: "text-zinc-400 hover:text-zinc-200 text-sm w-fit transition" %>

  <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-6 flex flex-col gap-4">
    <h1 class="text-2xl font-bold text-white"><%= @company.name %></h1>

    <div class="flex flex-wrap gap-2">
      <% if @company.city.present? %>
        <span class="bg-zinc-950 text-zinc-300 text-sm px-3 py-1 rounded-full"><%= @company.city %></span>
      <% end %>
      <% if @company.industry.present? %>
        <span class="bg-zinc-950 text-zinc-300 text-sm px-3 py-1 rounded-full"><%= @company.industry %></span>
      <% end %>
      <span class="bg-zinc-950 text-zinc-300 text-sm px-3 py-1 rounded-full"><%= @company.remote_policy.humanize %></span>
      <span class="bg-zinc-950 text-zinc-300 text-sm px-3 py-1 rounded-full">Japanese: <%= @company.japanese_level.humanize %></span>
      <% if @company.hires_juniors? %>
        <span class="bg-[#2a3324] text-[#9cbf7a] text-sm px-3 py-1 rounded-full">Hires juniors</span>
      <% end %>
      <% if @company.visa_sponsorship? %>
        <span class="bg-amber-950 text-amber-400 text-sm px-3 py-1 rounded-full">Visa sponsorship</span>
      <% end %>
      <% if @company.english_ok? %>
        <span class="bg-[#3d2420] text-[#e8a688] text-sm px-3 py-1 rounded-full">English OK</span>
      <% end %>
    </div>

    <% if @company.description.present? %>
      <p class="text-zinc-300 leading-relaxed border-t border-zinc-800 pt-3"><%= @company.description %></p>
    <% end %>

    <% if @company.tech_stack.present? %>
      <div class="text-sm">
        <span class="text-zinc-500">Tech stack:</span>
        <span class="text-zinc-300"><%= @company.tech_stack %></span>
      </div>
    <% end %>

    <% if @company.notes.present? %>
      <div class="text-sm bg-zinc-950 border border-zinc-800 rounded-md p-3 text-zinc-400">
        <span class="font-medium text-zinc-300">Notes:</span> <%= @company.notes %>
      </div>
    <% end %>

    <div class="flex items-center justify-between border-t border-zinc-800 pt-3 text-sm">
      <% if @company.careers_url.present? %>
        <%= link_to "Careers page →", @company.careers_url, target: "_blank", rel: "noopener",
            class: "text-[#D97757] hover:text-[#e8977a] font-medium transition" %>
      <% end %>
      <% if @company.source.present? %>
        <span class="text-zinc-500">Source: <%= @company.source %></span>
      <% end %>
    </div>

    <% if @company.last_verified_on.present? %>
      <p class="text-zinc-600 text-xs">Last verified <%= @company.last_verified_on.strftime("%B %-d, %Y") %></p>
    <% end %>
  </div>
</div>
