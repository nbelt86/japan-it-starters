<div class="flex flex-col gap-4 max-w-2xl w-full">
  <%= link_to "← Back to Companies", companies_path, class: "text-gray-400 hover:text-gray-200 text-sm w-fit transition" %>

  <div class="bg-gray-800 border border-gray-700 rounded-lg p-6 flex flex-col gap-4">
    <h1 class="text-2xl font-bold text-white"><%= @company.name %></h1>

    <div class="flex flex-wrap gap-2">
      <% if @company.city.present? %>
        <span class="bg-gray-900 text-gray-300 text-sm px-3 py-1 rounded-full"><%= @company.city %></span>
      <% end %>
      <% if @company.industry.present? %>
        <span class="bg-gray-900 text-gray-300 text-sm px-3 py-1 rounded-full"><%= @company.industry %></span>
      <% end %>
      <span class="bg-gray-900 text-gray-300 text-sm px-3 py-1 rounded-full"><%= @company.remote_policy.humanize %></span>
      <span class="bg-gray-900 text-gray-300 text-sm px-3 py-1 rounded-full">Japanese: <%= @company.japanese_level.humanize %></span>
      <% if @company.hires_juniors? %>
        <span class="bg-green-950 text-green-400 text-sm px-3 py-1 rounded-full">Hires juniors</span>
      <% end %>
      <% if @company.visa_sponsorship? %>
        <span class="bg-blue-950 text-blue-400 text-sm px-3 py-1 rounded-full">Visa sponsorship</span>
      <% end %>
      <% if @company.english_ok? %>
        <span class="bg-purple-950 text-purple-400 text-sm px-3 py-1 rounded-full">English OK</span>
      <% end %>
    </div>

    <% if @company.description.present? %>
      <p class="text-gray-300 leading-relaxed border-t border-gray-700 pt-3"><%= @company.description %></p>
    <% end %>

    <% if @company.tech_stack.present? %>
      <div class="text-sm">
        <span class="text-gray-500">Tech stack:</span>
        <span class="text-gray-300"><%= @company.tech_stack %></span>
      </div>
    <% end %>

    <% if @company.notes.present? %>
      <div class="text-sm bg-gray-900 border border-gray-700 rounded-md p-3 text-gray-400">
        <span class="font-medium text-gray-300">Notes:</span> <%= @company.notes %>
      </div>
    <% end %>

    <div class="flex items-center justify-between border-t border-gray-700 pt-3 text-sm">
      <% if @company.careers_url.present? %>
        <%= link_to "Careers page →", @company.careers_url, target: "_blank", rel: "noopener",
            class: "text-blue-400 hover:text-blue-300 font-medium transition" %>
      <% end %>
      <% if @company.source.present? %>
        <span class="text-gray-500">Source: <%= @company.source %></span>
      <% end %>
    </div>

    <% if @company.last_verified_on.present? %>
      <p class="text-gray-600 text-xs">Last verified <%= @company.last_verified_on.strftime("%B %-d, %Y") %></p>
    <% end %>
  </div>
</div>
