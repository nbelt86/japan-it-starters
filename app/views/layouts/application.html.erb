<!DOCTYPE html>
<html>
  <head>
    <title>Japan IT Starters</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-zinc-950">
    <nav class="flex justify-between items-center px-6 py-4 bg-zinc-950 border-b border-zinc-800 shadow-lg">
      <%= link_to "Japan IT Starters", root_path,
          class: "text-2xl font-extrabold tracking-tight bg-gradient-to-r from-[#B5442E] to-[#D97757] bg-clip-text text-transparent" %>
      <span class="text-zinc-500 text-sm hidden sm:inline">Companies in Japan that hire junior foreign talent</span>
    </nav>

    <main class="container mx-auto mt-10 px-5 pb-16">
      <% if notice.present? %>
        <div class="mb-4 px-4 py-3 rounded-md bg-emerald-900/40 border border-emerald-700 text-emerald-300 text-sm"><%= notice %></div>
      <% end %>
      <% if alert.present? %>
        <div class="mb-4 px-4 py-3 rounded-md bg-red-900/40 border border-red-700 text-red-300 text-sm"><%= alert %></div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
